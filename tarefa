
#include <stdio.h>

int main() {
    float c,m; 
    float s=0;
    int i;
    //c = consumo,m = media,s = soma//
    printf("calculador de consumo de gasto medio de agua por m3\n");
    printf("insira os valores de consumo de cada morador\n");
    for (i = 1; i <= 5; i++) {
        printf("Digite o consumo do morador %d (em m3)\n", i);
        scanf("%f", &c);

        s+=c;

        if (c<= 20) {
            printf("Consumo dentro da media.\n");
        } else {
            printf("Consumo acima da media.\n");
        }
    }

    m=s/5;

    printf("Consumo medio geral: %.2f m3\n",m);

    return 0;
}
