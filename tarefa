#include <stdio.h>

int main() {
    int i;
    float n, s = 0, m;

    // n = nota, s = soma, m = media//

    printf("Digite as notas dos clientes, de 0 a 10.\n");

    for (i = 1; i <= 10; i++) {
        printf("Digite a nota do cliente %d: ", i);
        scanf("%f", &n);

        if (n < 0 || n > 10) {
            printf("Nota invalida!\n");
            return 0;
        } else {
            s += n;
        }
    }

    m = s / 10;

    printf("Media geral: %.2f\n", m);

    if (m < 7) {
        printf("ALERTA: A media de atendimento esta abaixo de 7!\n");
    } else {
        printf("A media de atendimento esta dentro do esperado.\n");
    }

    return 0;
}
