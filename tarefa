#include <stdio.h>

int main() {
    int h = 0, p, s = 0, m;

    // h = horas, p = passos, s = soma dos passos, m = media

    printf("=== MARCADOR DE PASSOS DIARIOS ===\n");
    printf("Este programa registra os passos dados a cada hora.\n");
    printf("A meta diaria eh atingir pelo menos 10000 passos.\n");
    printf("Ao final, sera informado o total, as horas e a media por hora.\n");

    while (s < 10000) {
        h++;

        printf("Digite os passos da hora %d: ", h);
        scanf("%d", &p);

        s = s + p;
    }

    m = s / h;

    printf("Meta atingida!\n");
    printf("Total de passos: %d\n", s);
    printf("Horas necessarias: %d\n", h);
    printf("Media de passos por hora: %d\n", m);

    return 0;
}
