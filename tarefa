#include <stdio.h>

int main() {
    int opcao;
    float saldo = 0;

    do {
        printf("=== COFRINHO DIGITAL ===\n");
        printf("1 - Adicionar R$ 0,50\n");
        printf("2 - Adicionar R$ 1,00\n");
        printf("3 - Adicionar R$ 2,00\n");
        printf("4 - Parar\n");
        printf("Escolha uma opcao\n");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                saldo += 0.50;
                break;

            case 2:
                saldo += 1.00;
                break;

            case 3:
                saldo += 2.00;
                break;

            case 4:
                printf("Encerrando o cofrinho...\n");
                break;

            default:
                printf("Opcao invalida!\n");
        }
           if ((opcao>=1)&&(opcao<=3)) {
            printf("Moeda adicionada!\n");
            printf("Novo saldo: R$ %.2f\n", saldo);
        }

    } while (opcao!=4);

    printf("Total acumulado: R$ %.2f\n", saldo);

    return 0;
}
